.{
    .name = .stdx,
    .version = "0.0.0",
    .fingerprint = 0x5479474f829ec509, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The test runner and the bench engine. Lazy: only the root build
        // uses it, and build.zig returns early for a consumer.
        .testingx = .{
            .url = "git+https://github.com/baskingspot/testingx#e96eb61de42250a5be03e631b835b3d9f23c8310",
            .hash = "testingx-0.1.1-ib95-6ivAgB3rCWLHww0C7edG1NLC71y1p1wogPV0Djf",
            .lazy = true,
        },
        // The API reference generator. Lazy for the same reason: only the
        // root build's docs step runs it, and the site's api.html reads the
        // JSON it writes.
        .docgen = .{
            .url = "git+https://github.com/baskingspot/docgen#de811853ea2e937a2397c1d45a2350ae39a1c0aa",
            .hash = "docgen-0.0.0-vnM6Vf3zAQAAdrMwRp_P0teDytVZPRId-MpdxgCEwJPN",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "LICENSE-ZIG",
        "README.md",
        "THIRD_PARTY.md",
    },
}
