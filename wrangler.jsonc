{
  // Schema lives on unpkg because this repo has no node_modules.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "stdx-withmatt-com",
  // Set to the date of the last deploy-relevant config change.
  "compatibility_date": "2026-10-13",
  // Pure static site: no worker script, so no `main` and no `binding`.
  // Asset requests are free and served from cache without any invocation.
  "assets": {
    // Output of `zig build docs` (see justfile `doc`).
    "directory": "./zig-out/zig-docs",
    // Plain 404 for unknown paths (not an SPA, no 404.html).
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  },
  // stdx.withmatt.com is attached via Terraform in ~/code/cloudflare
  // (cloudflare_workers_custom_domain). No routes here: the CI deploy
  // token is script-scoped and cannot touch DNS or domains, so deploys
  // are pure version uploads. Keep the workers.dev subdomain off so the
  // site has a single canonical origin.
  "workers_dev": false
}
